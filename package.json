{
	"name": "rivtuber",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"electron": "vite build && electron electron/main.js",
		"prepare": "svelte-kit sync && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint --max-warnings 0 . && prettier --check . && stylelint \"src/**/*.{css,svelte}\" --max-warnings 0",
		"lint-staged": "lint-staged"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"electron": "^45.0.0",
		"eslint": "^10.13.0",
		"eslint-plugin-better-tailwindcss": "^4.10.0",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"postcss-html": "^2.0.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.0",
		"vite-plugin-static-copy": "4.1.1"
	},
	"dependencies": {
		"@mediapipe/tasks-vision": "1.1.1",
		"@rive-app/webgl2": "2.45.0"
	}
}
